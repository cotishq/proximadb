{
  "uid": "proximadb",
  "title": "ProximaDB",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc) (proxima_requests_total)",
          "legendFormat": "{{rpc}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc) (rate(proxima_requests_total[1m]))",
          "legendFormat": "{{rpc}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, rpc) (rate(proxima_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{rpc}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, rpc) (rate(proxima_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 {{rpc}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Live vectors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "proxima_index_size"
        }
      ]
    }
  ]
}
